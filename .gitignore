# See https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files for more about ignoring files.

# Build outputs
dist/
packages/*/dist/
*.tsbuildinfo

# Don't commit JS files in TS projects
packages/*/src/**/*.js
packages/*/src/**/*.js.map
packages/*/src/**/*.d.ts

# Don't commit maps
*.map

# Node modules
node_modules/

# IDE files
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json
.idea/
*.iml
*.swp
*.swo

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# System files
.DS_Store
Thumbs.db

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings

# NX files
.nx/cache
.nx/workspace-data
