{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "es2020",
    "lib": [
      "es2020"
    ],
    "outDir": "./dist",
    "sourceMap": true,
    "rootDir": "../../",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vscode",
      "estree",
      "json-schema"
    ]
  },
  "include": [
    "src",
    "../shared/src/**/*.ts",
    "../stylelint-oldfashioned-order/src/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "../shared/src/**/*.test.ts",
    "../shared/src/tests/**/*.ts",
    "../stylelint-oldfashioned-order/src/tests/**/*.ts"
  ]
}