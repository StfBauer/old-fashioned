{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "target": "ES2020",
    "outDir": "dist",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": true,
    "strict": true,
    "noImplicitAny": false, /* Critical for VS Code extensions */
    "noImplicitReturns": true,
    "strictNullChecks": true,
    "lib": [
      "ES2020"
    ],
    /* Remove "types": ["node"] - VS Code extension shouldn't explicitly include vscode in types */
    "baseUrl": ".",
    "paths": {
      "@old-fashioned/shared": [
        "../shared/dist"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts"
  ],
  "references": [
    {
      "path": "../shared"
    }
  ]
}