{
  "name": "vscode-old-fashioned",
  "displayName": "Old Fashioned CSS Sorter",
  "description": "Sort CSS properties according to oldschool conventions",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.60.0"
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:scss",
    "onLanguage:sass"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "old-fashioned.sortProperties",
        "title": "Sort CSS Properties",
        "category": "Old Fashioned"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "when": "editorLangId == css || editorLangId == scss || editorLangId == sass",
          "command": "old-fashioned.sortProperties",
          "group": "1_modification"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "@types/vscode": "^1.60.0",
    "typescript": "^4.9.5"
  }
}