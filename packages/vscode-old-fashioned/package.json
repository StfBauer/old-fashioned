{
  "name": "vscode-old-fashioned",
  "displayName": "Old Fashioned CSS Property Sorter",
  "version": "0.0.1",
  "description": "A CSS property sorter with multiple sorting strategies",
  "publisher": "n8design",
  "author": "Stefan Bauer (@stfbauer)",
  "license": "MIT",
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/stfbauer"
    },
    {
      "type": "github",
      "url": "https://github.com/sponsors/n8design"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/n8design/old-fashioned.git"
  },
  "homepage": "https://github.com/n8design/old-fashioned/tree/main/packages/vscode-old-fashioned",
  "bugs": {
    "url": "https://github.com/n8design/old-fashioned/issues"
  },
  "galleryBanner": {
    "color": "#1f1f1f",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "icon": "images/old-fashioned.png",
  "categories": [
    "Formatters",
    "Linters"
  ],
  "keywords": [
    "css",
    "sorting",
    "formatter",
    "scss",
    "less"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vscode-old-fashioned.hello",
        "title": "Hello Old Fashioned"
      }
    ],
    "configuration": {
      "title": "Old Fashioned",
      "properties": {
        "old-fashioned.sorting.strategy": {
          "type": "string",
          "default": "alphabetical",
          "enum": [
            "alphabetical",
            "concentric",
            "idiomatic",
            "custom"
          ],
          "description": "The sorting strategy to use for CSS properties"
        },
        "old-fashioned.sorting.emptyLinesBetweenGroups": {
          "type": "boolean",
          "default": false,
          "description": "Whether to add empty lines between property groups"
        },
        "old-fashioned.sorting.sortPropertiesWithinGroups": {
          "type": "boolean",
          "default": true,
          "description": "Whether to sort properties alphabetically within groups"
        }
      }
    }
  },
  "dependencies": {
    "ajv": "^8.12.0",
    "postcss": "^8.4.24",
    "postcss-scss": "^4.0.9",
    "stylelint": "^16.0.0",
    "vscode": "^1.87.0"
  },
  "devDependencies": {
    "@types/estree": "^1.0.7",
    "@types/json-schema": "^7.0.15",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/vsce": "^2.22.0",
    "esbuild": "^0.20.0",
    "postcss-scss": "^4.0.9"
  },
  "directories": {
    "test": "test"
  },
  "type": "commonjs",
  "types": "./dist/extension.d.ts",
  "bundleDependencies": [
    "postcss",
    "postcss-scss",
    "stylelint"
  ]
}