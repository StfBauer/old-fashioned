{
    "name": "vscode-old-fashioned",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "packages/vscode-old-fashioned/src",
    "projectType": "application",
    "targets": {
        "build": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/vscode-old-fashioned",
                "command": "npm run esbuild"
            },
            "outputs": [
                "{projectRoot}/dist"
            ],
            "dependsOn": [
                {
                    "projects": [
                        "shared",
                        "stylelint-oldfashioned-order"
                    ],
                    "target": "build"
                }
            ]
        },
        "package": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/vscode-old-fashioned",
                "command": "npm run package"
            },
            "dependsOn": [
                "build"
            ],
            "outputs": [
                "{projectRoot}/*.vsix"
            ]
        },
        "lint": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/vscode-old-fashioned",
                "command": "npm run lint"
            }
        },
        "test": {
            "executor": "nx:run-commands",
            "options": {
                "cwd": "packages/vscode-old-fashioned",
                "command": "vitest run"
            }
        },
        "publish": {
            "executor": "nx:run-commands",
            "options": {
                "command": "npx @vscode/vsce publish --no-dependencies",
                "cwd": "packages/vscode-old-fashioned"
            },
            "dependsOn": [
                "build"
            ]
        },
        "version": {
            "executor": "nx:run-commands",
            "options": {
                "command": "echo 'VS Code extension version updated via sync-versions.js'",
                "cwd": "packages/vscode-old-fashioned"
            }
        }
    },
    "tags": []
}
