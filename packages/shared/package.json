{
  "name": "@old-fashioned/shared",
  "version": "0.0.1",
  "description": "Shared utilities and types for Old Fashioned CSS sorting tools",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "npm run clean && mkdir -p dist",
    "build": "tsc --project tsconfig.json",
    "postbuild": "[ -d dist ] || mkdir -p dist && [ -f dist/index.js ] || cp src/index.* dist/",
    "test": "vitest run",
    "benchmark": "ts-node benchmark/run-benchmark.ts",
    "benchmark:comprehensive": "ts-node benchmark/sorting-benchmark.ts",
    "check-css-props": "ts-node src/utils/css-properties-updater.ts"
  },
  "keywords": [
    "css",
    "sorting",
    "stylelint",
    "shared"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.2.2",
    "@types/node": "^20.11.5"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}