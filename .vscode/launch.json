{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Extension",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode-old-fashioned/",
                "${workspaceFolder}/packages/vscode-old-fashioned/test/",
                "--profile",
                "Clean Test Profile"
            ],
            "outFiles": [
                "${workspaceFolder}/packages/vscode-old-fashioned/dist/**/*.js"
            ],
            "preLaunchTask": "build-extension",
            "trace": true,
            "cwd": "${workspaceFolder}" // Explicitly set CWD to the extension's folder
        }
    ]
}