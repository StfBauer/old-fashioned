{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "tasksRunnerOptions": {
    "default": {
      "runner": "nx/tasks-runners/default",
      "options": {
        "cacheableOperations": [
          "build",
          "lint",
          "test",
          "package",
          "publish"
        ],
        "parallel": 3
      }
    }
  },
  "targetDefaults": {
    "build": {
      "executor": "@nx/js:tsc",
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "production",
        "^production"
      ],
      "outputs": [
        "{projectRoot}/dist"
      ]
    },
    "package": {
      "dependsOn": [
        "build"
      ]
    },
    "publish": {
      "dependsOn": [
        "package"
      ]
    },
    "test": {
      "executor": "nx:run-commands",
      "inputs": [
        "default",
        "^production",
        "{workspaceRoot}/vitest.config.ts"
      ],
      "options": {
        "command": "vitest run --passWithNoTests"
      }
    },
    "lint": {
      "inputs": [
        "default",
        "{workspaceRoot}/.eslintrc.json"
      ]
    }
  },
  "workspaceLayout": {
    "appsDir": "packages",
    "libsDir": "packages"
  },
  "plugins": [],
  "defaultBase": "main",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "sharedGlobals": [
      "{workspaceRoot}/package.json",
      "{workspaceRoot}/tsconfig.base.json"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/*.spec.ts",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/.eslintrc.json"
    ]
  },
  "release": {
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "projectChangelogs": {
        "file": "{projectRoot}/CHANGELOG.md",
        "createRelease": false
      },
      "workspaceChangelog": {
        "file": "{workspaceRoot}/CHANGELOG.md",
        "createRelease": "github"
      }
    },
    "groups": {
      "npm-packages": {
        "projects": [
          "stylelint-oldfashioned-order"
        ],
        "releaseTagPattern": "{projectName}-v{version}"
      },
      "extensions": {
        "projects": [
          "vscode-old-fashioned"
        ],
        "dependsOn": [
          "npm-packages"
        ],
        "releaseTagPattern": "{projectName}-v{version}"
      }
    },
    "git": {
      "commit": true,
      "tag": true,
      "commitMessage": "chore(release): publish {version}"
    }
  }
}